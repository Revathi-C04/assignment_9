# Copy this file to ".env" and fill in your own values.

# Port the server listens on
PORT=3000

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/auth_app
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth_app?retryWrites=true&w=majority

# Long random string used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" when deploying behind HTTPS (enables secure cookies)
NODE_ENV=development
